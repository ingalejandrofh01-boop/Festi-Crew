rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada crew vive en crews/{codigo}. Hay que haber entrado (sesión anónima) para leer o escribir.
    match /crews/{crew}/{col}/{id} {
      allow read: if request.auth != null;
      // Eventos y artistas: cualquiera del crew puede editarlos.
      // Personas: cada quien solo puede escribir su propio documento (votos, asistencia, boleto).
      allow write: if request.auth != null
                   && (col != 'people' || id == request.auth.uid)
                   && (request.resource == null || request.resource.size() < 60);
    }
  }
}
